---
const today = new Date();
const { showConsentLink = false } = Astro.props;
---

<footer>
	<p>&copy; {today.getFullYear()} Home Theory. All rights reserved.</p>
	<p class="disclaimer">General guidance based on HDB rules. Not financial or legal advice.</p>
	<p class="disclaimer"><a href="/privacy">Privacy</a></p>
	{showConsentLink && <p class="disclaimer"><button type="button" id="consent-reset">Analytics settings</button></p>}
</footer>

<style>
	footer {
		padding: 0.4em 1em;
		background: #FAF7F2;
		color: #7A6F5F;
		text-align: center;
		font-size: 12px;
		line-height: 1.4;
		border-top: 1px solid #EEE9E0;
	}
	.disclaimer {
		margin-top: 2px;
		font-size: 10px;
		color: #9A8C77;
	}

	footer p {
    margin: 0;
}
	footer a {
		color: inherit;
		text-decoration: underline;
	}
	#consent-reset {
		padding: 0;
		border: none;
		background: none;
		color: inherit;
		font: inherit;
		text-decoration: underline;
		cursor: pointer;
	}
</style>

<script>
	import { resetConsent } from '../analytics/consent.js'
	document.getElementById('consent-reset')?.addEventListener('click', resetConsent)
</script>

